OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

APIFY_API_TOKEN=
APIFY_ACTOR_ID=automation-lab/amazon-reviews-scraper

# Optional stronger review provider. When set, reports combine Canopy + Apify and dedupe reviews.
CANOPY_API_KEY=
# Also accepted if your dashboard uses a different name:
# CANOPYAPI_API_KEY=
# CANOPY_TOKEN=
CANOPY_MAX_REVIEWS=100

RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@yourdomain.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time products:
# STRIPE_PRICE_REPORT_100 = Quick Signal, $19, 2 credits
# STRIPE_PRICE_REPORT_250 = Research Pack, $59, 6 credits
# STRIPE_PRICE_REPORT_500 and STRIPE_PRICE_REPORT_1000 are kept for backward compatibility if you already created them.
STRIPE_PRICE_REPORT_100=
STRIPE_PRICE_REPORT_250=
STRIPE_PRICE_REPORT_500=
STRIPE_PRICE_REPORT_1000=
# Subscriptions:
# STRIPE_PRICE_SOLO = Solo, $49/mo, 10 credits
# STRIPE_PRICE_GROWTH = Brand, $149/mo, 40 credits
# STRIPE_PRICE_BRAND and STRIPE_PRICE_AGENCY are kept for backward compatibility if you already created them.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BRAND=
STRIPE_PRICE_AGENCY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
